ROBINE_HOST=ci.example.com
ROBINE_PUBLIC_URL=https://ci.example.com
PHX_HOST=ci.example.com
PHX_SERVER=true
PORT=4000
DATABASE_URL=ecto://robine:replace-with-generated-password@postgres/robine
POSTGRES_PASSWORD=replace-with-generated-password
SECRET_KEY_BASE=replace-with-generated-secret
ROBINE_CI_SECRET_KEY=replace-with-generated-key
ROBINE_BOOTSTRAP_TOKEN=replace-with-generated-token
ROBINE_STORAGE_ROOT=/var/lib/robine/storage
ROBINE_BUNDLED_RUNNER_ENABLED=true
ROBINE_LOCAL_RUNNER_ENABLED=false
ROBINE_BUNDLED_RUNNER_BOOTSTRAP_DIRECTORY=/var/lib/robine-runner-bootstrap
ROBINE_BUNDLED_RUNNER_NAME=robine-local
ROBINE_RUNNER_RESOURCE_NAMESPACE=production
ROBINE_RUNNER_CPU_MILLIS=2000
ROBINE_RUNNER_MEMORY_BYTES=4294967296
ROBINE_RUNNER_PIDS_LIMIT=512
ROBINE_RUNTIME_IMAGE=ubuntu:26.04
