<Layouts.app flash={@flash} shell={false}>
  <div
    id="sign-in-page"
    class="mx-auto grid min-h-[calc(100vh-10rem)] max-w-6xl overflow-hidden rounded-[2rem] border border-base-300/80 bg-base-100 shadow-2xl shadow-base-content/10 lg:grid-cols-[1.08fr_0.92fr]"
  >
    <section
      class="relative hidden overflow-hidden bg-neutral p-12 text-neutral-content lg:flex lg:flex-col"
      aria-label="Robine CI introduction"
    >
      <div class="absolute -right-32 -top-32 size-96 rounded-full bg-emerald-400/15 blur-3xl">
      </div>
      <div class="absolute -bottom-24 -left-24 size-80 rounded-full bg-lime-300/10 blur-3xl">
      </div>
      <div class="login-grid absolute inset-0 opacity-[0.08]"></div>

      <div class="relative flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-2xl bg-primary text-lg font-black text-primary-content shadow-lg shadow-primary/25">R</span>
        <span class="text-lg font-bold tracking-tight">Robine
        <span class="text-white/40">CI</span></span>
      </div>

      <div class="relative my-auto py-16">
        <p class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-emerald-300">
          <span class="h-px w-8 bg-emerald-300/70"></span> Your pipelines, under control
        </p>
        <h2 class="max-w-lg text-5xl font-semibold leading-[1.02] tracking-[-0.055em]">
          Ship confidently.<br /><span class="text-white/45">Debug quickly.</span>
        </h2>
        <p class="mt-7 max-w-md text-base leading-7 text-white/55">
          A focused control plane for trusted repositories, reproducible jobs and the signal your team needs.
        </p>

        <div class="mt-12 grid grid-cols-3 gap-3">
          <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
            <.icon name="hero-bolt" class="size-5 text-emerald-300" /><p class="mt-4 text-xs font-semibold text-white/70">
              Fast feedback
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
            <.icon name="hero-shield-check" class="size-5 text-emerald-300" /><p class="mt-4 text-xs font-semibold text-white/70">
              Trusted runs
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
            <.icon name="hero-command-line" class="size-5 text-emerald-300" /><p class="mt-4 text-xs font-semibold text-white/70">
              Local parity
            </p>
          </div>
        </div>
      </div>

      <p class="relative flex items-center gap-2 text-xs text-white/35">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        Self-hosted infrastructure · Your data stays yours
      </p>
    </section>

    <section class="flex items-center px-6 py-12 sm:px-12 lg:px-14">
      <div class="mx-auto w-full max-w-sm">
        <div class="mb-10 lg:hidden">
          <span class="grid size-11 place-items-center rounded-2xl bg-primary text-lg font-black text-primary-content">R</span>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Welcome back</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight">Sign in to Robine</h1>
        <p class="mt-3 text-sm leading-6 text-base-content/55">
          Access your pipelines, repositories and instance settings.
        </p>

        <.form for={@form} id="sign-in-form" action={~p"/sign-in"} class="mt-9 space-y-5">
          <.input
            field={@form[:email]}
            type="email"
            label="Email address"
            required
            autocomplete="username"
            placeholder="you@company.com"
          />
          <.input
            field={@form[:password]}
            type="password"
            label="Password"
            required
            autocomplete="current-password"
            placeholder="Enter your password"
          />
          <.button
            id="sign-in-submit"
            class="btn btn-primary mt-2 h-12 w-full gap-2"
            phx-disable-with="Signing in…"
          >Sign in <.icon name="hero-arrow-right" class="size-4" /></.button>
        </.form>

        <div
          :if={@oidc_enabled}
          class="my-7 flex items-center gap-4 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-base-content/35"
        >
          <span class="h-px flex-1 bg-base-300"></span>
          or continue with <span class="h-px flex-1 bg-base-300"></span>
        </div>
        <a
          :if={@oidc_enabled}
          id="oidc-sign-in"
          href={~p"/auth/oidc"}
          class="btn btn-outline h-12 w-full gap-3"
        ><.icon name="hero-building-office-2" class="size-5" /> Organization SSO</a>

        <div class="mt-8 flex items-start gap-3 rounded-xl bg-base-200/70 p-3.5 text-xs leading-5 text-base-content/50">
          <.icon name="hero-lock-closed" class="mt-0.5 size-4 shrink-0 text-base-content/35" /><p>
            Administrators can always use local credentials for emergency recovery.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
