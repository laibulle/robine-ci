<Layouts.app flash={@flash}>
  <div class="mx-auto flex min-h-[70vh] max-w-md items-center px-6">
    <section class="w-full rounded-3xl border border-base-300 bg-base-100 p-8 shadow-xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Robine CI</p>
      <h1 class="mt-3 text-3xl font-bold">Sign in</h1>
      <p class="mt-2 text-base-content/65">Continue to your pipelines and repositories.</p>
      <.form for={%{}} action={~p"/sign-in"} class="mt-8 space-y-5">
        <.input name="email" value="" type="email" label="Email" required autocomplete="username" />
        <.input
          name="password"
          value=""
          type="password"
          label="Password"
          required
          autocomplete="current-password"
        />
        <.button class="btn btn-primary w-full">Sign in</.button>
      </.form>
      <div :if={@oidc_enabled} class="divider my-7">or</div>
      <a :if={@oidc_enabled} href={~p"/auth/oidc"} class="btn btn-outline w-full">
        Continue with OpenID Connect
      </a>
      <p class="mt-6 text-center text-xs text-base-content/55">
        Instance administrators can always use this local recovery sign-in.
      </p>
    </section>
  </div>
</Layouts.app>
