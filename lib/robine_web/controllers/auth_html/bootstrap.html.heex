<Layouts.app flash={@flash}>
  <main class="mx-auto flex min-h-[70vh] max-w-md items-center px-6">
    <section class="w-full rounded-3xl border border-base-300 bg-base-100 p-8 shadow-xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">First run</p>
      <h1 class="mt-3 text-3xl font-bold">Create the administrator</h1>
      <p class="mt-2 text-base-content/65">
        Use the short-lived token supplied through <code>ROBINE_BOOTSTRAP_TOKEN</code>.
      </p>
      <.form for={%{}} action={~p"/setup"} class="mt-8 space-y-5">
        <.input
          name="token"
          value=""
          type="password"
          label="Setup token"
          required
          autocomplete="off"
        />
        <.input name="email" value="" type="email" label="Email" required autocomplete="username" />
        <.input
          name="password"
          value=""
          type="password"
          label="Password"
          required
          minlength="12"
          autocomplete="new-password"
        />
        <.button class="btn btn-primary w-full">Create administrator</.button>
      </.form>
    </section>
  </main>
</Layouts.app>
